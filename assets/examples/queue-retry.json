{
  "schemaVersion": 1,
  "title": "有界队列与一次重试",
  "summary": "合成教学场景：队列容量 8，工位并发 2；队满拒绝新任务。任务 A 失败后最多重试一次，再次失败进入错误出口。数字是完整步骤快照，不代表实测性能。",
  "template": "agent",
  "mode": "demo",
  "sources": [
    {
      "id": "scenario",
      "title": "内置合成排队与重试场景",
      "ref": "容量 8、并发 2、重试上限 1 为本教学场景的设定。"
    }
  ],
  "domains": [
    {
      "id": "work",
      "name": "任务处理",
      "description": "等待、并行处理、拒绝与失败出口。"
    }
  ],
  "nodes": [
    {
      "id": "queue",
      "domainId": "work",
      "label": "等待料仓",
      "kind": "queue",
      "description": "等待任务与运行任务分开计数；队列满时不接收新任务。",
      "inputs": [
        "合成任务"
      ],
      "outputs": [
        "处理状态"
      ],
      "behaviour": "等待任务与运行任务分开计数；队列满时不接收新任务。",
      "evidence": "demo",
      "sources": [
        "scenario"
      ],
      "mechanism": {
        "capacity": 8
      }
    },
    {
      "id": "workers",
      "domainId": "work",
      "label": "双工位",
      "kind": "processor",
      "description": "两个工位处理独立任务。重试拨盘仅表示任务 A 的累计重试次数；任务 A 原位重试。",
      "inputs": [
        "合成任务"
      ],
      "outputs": [
        "处理状态"
      ],
      "behaviour": "两个工位处理独立任务。重试拨盘仅表示任务 A 的累计重试次数；任务 A 原位重试。",
      "evidence": "demo",
      "sources": [
        "scenario"
      ],
      "mechanism": {
        "concurrency": 2,
        "retryLimit": 1
      }
    },
    {
      "id": "failure",
      "domainId": "work",
      "label": "错误出口",
      "kind": "display",
      "description": "任务 A 第二次失败后离开工位，计入失败数。",
      "inputs": [
        "合成任务"
      ],
      "outputs": [
        "处理状态"
      ],
      "behaviour": "任务 A 第二次失败后离开工位，计入失败数。",
      "evidence": "demo",
      "sources": [
        "scenario"
      ]
    },
    {
      "id": "rejection",
      "domainId": "work",
      "label": "拒绝出口",
      "kind": "display",
      "description": "队列满时拒绝新增任务，保持队列数量为 8。",
      "inputs": [
        "合成任务"
      ],
      "outputs": [
        "处理状态"
      ],
      "behaviour": "队列满时拒绝新增任务，保持队列数量为 8。",
      "evidence": "demo",
      "sources": [
        "scenario"
      ]
    }
  ],
  "edges": [
    {
      "id": "dispatch",
      "from": "queue",
      "to": "workers",
      "label": "调度到空闲工位",
      "kind": "control",
      "evidence": "demo",
      "sources": [
        "scenario"
      ]
    },
    {
      "id": "failed",
      "from": "workers",
      "to": "failure",
      "label": "达到重试上限后退出",
      "kind": "data",
      "evidence": "demo",
      "sources": [
        "scenario"
      ]
    },
    {
      "id": "reject",
      "from": "queue",
      "to": "rejection",
      "label": "队满拒绝新任务",
      "kind": "control",
      "evidence": "demo",
      "sources": [
        "scenario"
      ]
    }
  ],
  "steps": [
