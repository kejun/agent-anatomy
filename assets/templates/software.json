{
  "schemaVersion": 1,
  "title": "软件服务的请求工厂",
  "summary": "请求从入口进入服务，必要时读取缓存或数据；耗时工作进入后台队列。该模板是合成机制示例，使用时应按源码改写。",
  "template": "software",
  "mode": "demo",
  "theme": "light",
  "sources": [
    {
      "id": "scenario",
      "title": "内置合成教学场景",
      "ref": "本页为一般机制示例，不代表任何真实项目或实际性能。"
    }
  ],
  "domains": [
    {
      "id": "entry",
      "name": "请求入口",
      "description": "路由与校验。"
    },
    {
      "id": "service",
      "name": "业务服务",
      "description": "同步处理和后台任务。"
    },
    {
      "id": "storage",
      "name": "数据",
      "description": "缓存与持久化。"
    }
  ],
  "nodes": [
    {
      "id": "gateway",
      "domainId": "entry",
      "label": "入口交换台",
      "kind": "router",
      "description": "将请求交给正确的服务入口。",
      "inputs": [
        "客户端请求"
      ],
      "outputs": [
        "路由后的请求"
      ],
      "behaviour": "连线表示路由关系，不假设存在独立 API 网关产品。",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "api",
      "domainId": "entry",
      "label": "请求控制台",
      "kind": "console",
      "description": "校验输入并启动业务操作。",
      "inputs": [
        "路由后的请求"
      ],
      "outputs": [
        "操作参数",
        "响应"
      ],
      "behaviour": "进入内部查看校验与处理。",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "service",
      "domainId": "service",
      "label": "业务机芯",
      "kind": "processor",
      "description": "执行请求所需的业务规则。",
      "inputs": [
        "操作参数",
        "数据"
      ],
      "outputs": [
        "业务结果"
      ],
      "behaviour": "实际业务职责须由源代码证实。",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "jobs",
      "domainId": "service",
      "label": "后台工单仓",
      "kind": "queue",
      "description": "保存可以延后执行的工作。",
      "inputs": [
        "后台工单"
      ],
      "outputs": [
        "待处理任务"
      ],
      "behaviour": "不把同步响应与后台完成混为一项。",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "cache",
      "domainId": "storage",
      "label": "缓存转盘",
      "kind": "memory",
      "description": "在已有条目可用时提供数据。",
      "inputs": [
        "缓存键"
      ],
      "outputs": [
        "可用条目或缺失"
      ],
      "behaviour": "命中与失效策略应按项目实现改写。",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "database",
      "domainId": "storage",
      "label": "持久化柜",
      "kind": "database",
      "description": "读取和保存业务数据。",
      "inputs": [
        "查询",
        "修改"
      ],
      "outputs": [
        "记录",
        "写入结果"
      ],
      "behaviour": "柜体代表持久化，不指代特定数据库。",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "validation",
      "domainId": "entry",
      "label": "输入校验",
      "kind": "router",
      "description": "检查请求字段与约束。",
      "inputs": [
        "请求"
      ],
      "outputs": [
        "有效参数"
      ],
      "behaviour": "无效输入应返回明确错误。",
      "evidence": "demo",
      "sources": [],
      "parentId": "api"
    },
    {
      "id": "handler",
      "domainId": "entry",
      "label": "请求处理",
      "kind": "processor",
      "description": "将参数交给业务服务。",
      "inputs": [
        "有效参数"
      ],
      "outputs": [
        "服务结果"
      ],
      "behaviour": "不要从函数名称猜测其实现。",
      "evidence": "demo",
      "sources": [],
      "parentId": "api"
    }
  ],
  "edges": [
    {
      "id": "g-a",
      "from": "gateway",
      "to": "api",
      "label": "路由请求",
      "kind": "control",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "a-s",
      "from": "api",
      "to": "service",
      "label": "启动业务",
      "kind": "control",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "s-c",
      "from": "service",
      "to": "cache",
      "label": "查询缓存",
      "kind": "data",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "c-s",
      "from": "cache",
      "to": "service",
      "label": "缓存条目",
      "kind": "data",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "s-d",
      "from": "service",
      "to": "database",
      "label": "读取或写入",
      "kind": "data",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "d-s",
      "from": "database",
      "to": "service",
      "label": "数据库结果",
      "kind": "data",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "s-j",
      "from": "service",
      "to": "jobs",
      "label": "提交后台工单",
      "kind": "data",
      "evidence": "demo",
      "sources": []
    },
    {
      "id": "v-h",
      "from": "validation",
      "to": "handler",
      "label": "有效参数",
      "kind": "data",
      "evidence": "demo",
      "sources": []
    }
  ],
  "steps": [
    {
      "id": "route",
      "title": "路由请求",
      "description": "入口只负责已声明的路由职责。",
      "active": [
        "gateway",
        "api"
      ],
      "edges": [
        "g-a"
      ]
    },
    {
      "id": "validate",
      "title": "校验输入",
      "description": "先校验参数，再进入业务规则。",
      "active": [
        "validation",
        "handler"
      ],
      "edges": [
        "v-h"
      ]
    },
    {
      "id": "cache-read",
      "title": "查看缓存",
      "description": "缓存可能命中，也可能需要继续读取数据库。",
      "active": [
        "service",
        "cache"
      ],
      "edges": [
        "s-c",
        "c-s"
      ]
    },
    {
      "id": "persist",
      "title": "访问持久化记录",
      "description": "这一步只是机制演示，未提供真实数据库延迟。",
      "active": [
        "database",
        "service"
      ],
      "edges": [
        "s-d",
        "d-s"
      ]
    },
    {
      "id": "background",
      "title": "拆出后台工单",
      "description": "可延后任务离开同步响应路径。",
      "active": [
        "jobs"
      ],
      "edges": [
        "s-j"
      ]
    }
  ]
}
